generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique // e.g., "CS", "BCA", "BBA", "BCOM", "MICRO"
  name      String   // e.g., "Department of Computer Science"
  degree    String   // e.g., "B.Sc. Computer Science"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students Student[]
  subjects Subject[]
}

model Student {
  id             String      @id @default(uuid())
  registerNumber String      @unique
  name           String
  batch          String      // e.g., "31924U180" or "2023-2026"
  batchYear      String      @default("2023 - 2026")
  degree         String      @default("B.Sc. Computer Science")
  departmentId   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  results    Result[]
}

model Semester {
  id        String    @id @default(uuid())
  number    Int       @unique // 1 to 6
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subjects Subject[]
}

model Subject {
  id           String      @id @default(uuid())
  code         String      @unique // e.g., "U18CS41"
  name         String
  credits      Int
  semesterId   String
  departmentId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  semester   Semester    @relation(fields: [semesterId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  results    Result[]
}

model Result {
  id            String   @id @default(uuid())
  studentId     String
  subjectId     String
  internalMarks Int
  externalMarks Int
  total         Int
  grade         String   // e.g., "O", "A+", "U"
  passStatus    Boolean  // true if passed, false if arrear
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
}
